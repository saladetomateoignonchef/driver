<!-- Fenêtre de message aux couleurs de Driver (remplace les boîtes de dialogue grises de Windows).
     Les couleurs et styles sont copiés depuis la fenêtre principale au moment de l'affichage. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Border Margin="18" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Color="#0B1F33"/>
    </Border.Effect>
    <DockPanel Margin="24,22,24,20">
      <!-- En-tête : pastille + titre -->
      <DockPanel DockPanel.Dock="Top" x:Name="DlgHeader" Background="Transparent">
        <Border x:Name="DlgIcon" Width="38" Height="38" CornerRadius="19" Background="#CCFBF1" DockPanel.Dock="Left">
          <TextBlock x:Name="DlgGlyph" Text="i" FontSize="19" FontWeight="Bold" Foreground="#0F766E"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="DlgTitle" Text="Driver" FontSize="17" FontWeight="SemiBold" Margin="14,0,0,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
      </DockPanel>
      <!-- Boutons -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="BtnDlgSecondary" Style="{DynamicResource BtnBase}" MinWidth="96" Margin="0,0,8,0" IsCancel="True"/>
        <Button x:Name="BtnDlgPrimary" Style="{DynamicResource BtnPrimary}" MinWidth="96" IsDefault="True"/>
      </StackPanel>
      <!-- Texte (défile s'il est long, ex. diagnostic d'un paquet) -->
      <ScrollViewer Margin="52,10,0,0" MaxHeight="380" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="DlgText" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource MutedBrush}"/>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
