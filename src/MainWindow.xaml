<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver" Width="1200" Height="800" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>

    <!-- ===== Palette (remplacée par Set-Theme pour le thème sombre) ===== -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E3E8ED"/>
    <SolidColorBrush x:Key="TextBrush" Color="#17202A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5D6B78"/>
    <SolidColorBrush x:Key="BtnLineBrush" Color="#D3DAE1"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ChipTextBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="DropLineBrush" Color="#9FB3C5"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#E6F4F1"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F766E"/>
    <SolidColorBrush x:Key="BannerBrush" Color="#CCFBF1"/>
    <SolidColorBrush x:Key="BannerTextBrush" Color="#134E4A"/>

    <!-- ===== Cartes ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style x:Key="CardWarn" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="BorderBrush" Value="#F59E0B"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- ===== Boutons ===== -->
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BtnLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="#0F766E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F766E"/>
    </Style>
    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="BtnLink" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" Padding="6,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Menu de gauche ===== -->
    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#B8C7D6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1A3249"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Interrupteur ===== -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource ToggleOffBrush}">
                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#0F766E"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Choix segmenté (paramètres) ===== -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="8" Padding="14,7" BorderThickness="1"
                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BtnLineBrush}">
              <ContentPresenter x:Name="cp" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0F766E"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#0F766E"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Case à cocher des lignes ===== -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="box" Width="20" Height="20" CornerRadius="5" BorderBrush="{DynamicResource DropLineBrush}"
                    BorderThickness="1.5" Background="{DynamicResource SurfaceBrush}">
              <Path x:Name="mark" Data="M4,10 L8,14 L16,6" Stroke="White" StrokeThickness="2.2" Visibility="Collapsed"
                    Stretch="None" Margin="-1.5,-1.5,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#0F766E"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#0F766E"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Zones de texte (page Liens) ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BtnLineBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== Tableaux ===== -->
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="Margin" Value="14,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="RowHeight" Value="36"/>
      <Setter Property="Margin" Value="1"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Menu de gauche ================= -->
    <Border Background="#12263A">
      <DockPanel Margin="14,20,14,16" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
          <!-- Logo "D" (même dessin que src/driver.ico) -->
          <Viewbox x:Name="LogoBox" Width="32" Height="32">
            <Canvas Width="256" Height="256">
              <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56" Fill="#0B1A29" Stroke="#2DD4BF" StrokeThickness="6"/>
              <Path Data="M78,62 L128,62 A66,66 0 0 1 128,194 L78,194 Z" Stroke="#2DD4BF" StrokeThickness="24" StrokeLineJoin="Round"/>
              <Path Data="M78,128 L128,128" Stroke="White" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Canvas.Left="66" Canvas.Top="116" Width="24" Height="24" Fill="White"/>
              <Ellipse Canvas.Left="128" Canvas.Top="116" Width="24" Height="24" Fill="White"/>
            </Canvas>
          </Viewbox>
          <TextBlock Text="Driver" Foreground="White" FontSize="20" FontWeight="Bold" Margin="11,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="NavDashboard" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavDashboard}"/></Button>
        <Button x:Name="NavUpdates" DockPanel.Dock="Top" Style="{StaticResource Nav}">
          <Grid>
            <TextBlock Text="{DynamicResource L_NavUpdates}"/>
            <Border x:Name="UpdatesBadge" HorizontalAlignment="Right" Background="#2DD4BF" CornerRadius="9" Padding="7,0" Visibility="Collapsed">
              <TextBlock x:Name="UpdatesBadgeText" Text="0" Foreground="#0B1F33" FontWeight="SemiBold" FontSize="11.5"/>
            </Border>
          </Grid>
        </Button>
        <Button x:Name="NavAll" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavAll}"/></Button>
        <Button x:Name="NavBackups" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavBackups}"/></Button>
        <Button x:Name="NavHistory" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavHistory}"/></Button>
        <Border DockPanel.Dock="Top" Height="1" Background="#21405C" Margin="10,10,10,13"/>
        <Button x:Name="NavHardware" DockPanel.Dock="Top" Style="{StaticResource Nav}">
          <Grid>
            <TextBlock Text="{DynamicResource L_NavHardware}"/>
            <Border x:Name="HardwareBadge" HorizontalAlignment="Right" Background="#FBBF24" CornerRadius="9" Padding="7,0" Visibility="Collapsed">
              <TextBlock x:Name="HardwareBadgeText" Text="0" Foreground="#0B1F33" FontWeight="SemiBold" FontSize="11.5"/>
            </Border>
          </Grid>
        </Button>
        <Button x:Name="NavSites" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavSites}"/></Button>
        <Button x:Name="NavLinks" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavLinks}"/></Button>
        <Button x:Name="NavPackage" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavPackage}"/></Button>
        <Button x:Name="NavLogs" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavLogs}"/></Button>
        <Button x:Name="NavSettings" DockPanel.Dock="Top" Style="{StaticResource Nav}"><TextBlock Text="{DynamicResource L_NavSettings}"/></Button>

        <Border DockPanel.Dock="Bottom" Background="#1A3249" CornerRadius="10" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="PcName" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock x:Name="PcInfo" Foreground="#B8C7D6" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ================= Contenu ================= -->
    <Grid Grid.Column="1" Margin="28,20,28,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Bandeaux : nouvelle version de Driver / nouveau matériel -->
      <StackPanel>
      <Border x:Name="HardwareBanner" Background="#FEF3C7" CornerRadius="10" Padding="16,10" Margin="0,0,0,14" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="BtnHardwareBanner" DockPanel.Dock="Right" Content="{DynamicResource L_BtnSeeHardware}" Style="{StaticResource BtnBase}" Padding="14,6"/>
          <TextBlock x:Name="HardwareBannerText" Foreground="#78350F" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
      </Border>
      <Border x:Name="AppUpdateBanner" Background="{DynamicResource BannerBrush}" CornerRadius="10" Padding="16,10" Margin="0,0,0,14" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BtnAppUpdateLater" Content="{DynamicResource L_Later}" Style="{StaticResource BtnLink}" Foreground="{DynamicResource BannerTextBrush}" Margin="0,0,6,0"/>
            <Button x:Name="BtnAppUpdate" Content="{DynamicResource L_BtnUpdateDriver}" Style="{StaticResource BtnPrimary}" Padding="14,6"/>
          </StackPanel>
          <TextBlock x:Name="AppUpdateText" Foreground="{DynamicResource BannerTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      </StackPanel>

      <!-- En-tête -->
      <Grid Grid.Row="1">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Tableau de bord" FontSize="24" FontWeight="Bold"/>
          <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{DynamicResource L_Ready}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnGitHubUpdate" Content="{DynamicResource L_BtnGitHubUpdate}" Style="{StaticResource BtnBase}" Margin="0,0,8,0"/>
          <Button x:Name="BtnSearch" Content="{DynamicResource L_BtnSearch}" Style="{StaticResource BtnBase}" Margin="0,0,8,0"/>
          <Button x:Name="BtnInstall" Content="{DynamicResource L_BtnInstall}" Style="{StaticResource BtnPrimary}" IsEnabled="False"/>
        </StackPanel>
      </Grid>

      <ProgressBar x:Name="Busy" Grid.Row="2" Height="4" IsIndeterminate="True" Visibility="Collapsed" Minimum="0" Maximum="100"
                   Margin="0,12,0,0" Foreground="#0F766E" Background="{DynamicResource LineBrush}" BorderThickness="0"/>

      <Grid Grid.Row="3" Margin="0,16,0,0">

        <!-- ===== Vue : tableau de bord ===== -->
        <Grid x:Name="ViewDashboard">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <UniformGrid Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_KpiDevices}" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="KpiDevices" Text="-" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_KpiUpdates}" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="KpiUpdates" Text="-" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_KpiRestore}" Style="{StaticResource Muted}"/>
                <CheckBox x:Name="ChkRestore" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,11,0,0" Content="{DynamicResource L_RestoreBefore}"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="CardsPanel" Columns="3" VerticalAlignment="Top" Margin="0,0,-12,0"/>
          </ScrollViewer>

          <Grid Grid.Row="2" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.4*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DropZone" Cursor="Hand" Background="Transparent">
              <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource DropLineBrush}" StrokeThickness="2" StrokeDashArray="4 3" Fill="{DynamicResource SurfaceBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="20,16" VerticalAlignment="Center">
                <Path Data="M15,4 L15,19 M8.5,12.5 L15,19 L21.5,12.5 M5,25 L25,25" Stroke="#0F766E" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="None" VerticalAlignment="Center"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource L_DropTitle}" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Text="{DynamicResource L_DropText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_RecentActivity}" FontWeight="SemiBold"/>
                <TextBlock x:Name="ActivityText" Style="{StaticResource Muted}" FontSize="12" LineHeight="20"
                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Text="{DynamicResource L_NoActivity}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ===== Vue : mises à jour ===== -->
        <Grid x:Name="ViewUpdates" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="UpdatesPanel"/>
          </ScrollViewer>
          <TextBlock x:Name="UpdatesEmpty" Text="{DynamicResource L_NoUpdates}" Style="{StaticResource Muted}"
                     FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- ===== Vue : tous les pilotes ===== -->
        <Border x:Name="ViewAll" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0">
          <DataGrid x:Name="AllGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Périphérique" Binding="{Binding Name}" Width="2.2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Fabricant" Binding="{Binding Manufacturer}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Version installée" Binding="{Binding DriverVersion}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="1.4*" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- ===== Vue : sauvegardes ===== -->
        <Grid x:Name="ViewBackups" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button x:Name="BtnBackupsClear" DockPanel.Dock="Right" Content="{DynamicResource L_DeleteAll}" Style="{StaticResource BtnSmall}"/>
            <TextBlock x:Name="BackupsInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BackupsPanel"/>
          </ScrollViewer>
          <TextBlock x:Name="BackupsEmpty" Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                     Text="{DynamicResource L_NoBackups}"/>
        </Grid>

        <!-- ===== Vue : historique ===== -->
        <Grid x:Name="ViewHistory" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button x:Name="BtnReport" DockPanel.Dock="Right" Content="{DynamicResource L_ExportReport}" Style="{StaticResource BtnSmall}"/>
            <TextBlock x:Name="HistoryInfo" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="HistoryGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="1.1*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="0.9*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Pilote" Binding="{Binding Device}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Avant" Binding="{Binding OldVersion}" Width="1*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Après" Binding="{Binding NewVersion}" Width="1*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Résultat" Binding="{Binding Result}" Width="0.9*" ElementStyle="{StaticResource CellText}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <TextBlock x:Name="HistoryEmpty" Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Visibility="Collapsed" Text="{DynamicResource L_NoHistory}"/>
        </Grid>

        <!-- ===== Vue : nouveau matériel ===== -->
        <Grid x:Name="ViewHardware" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{DynamicResource L_HwSaved}" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="HwConfigText" Style="{StaticResource Muted}" Margin="0,2,0,8"/>
              <TextBlock x:Name="HwSystemText" LineHeight="20" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <WrapPanel Grid.Row="1" Margin="0,12,0,12">
            <Button x:Name="BtnHwScan" Content="{DynamicResource L_HwScan}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
            <Button x:Name="BtnHwSave" Content="{DynamicResource L_HwSave}" Style="{StaticResource BtnBase}" IsEnabled="False" Margin="0,0,8,0"/>
            <Button x:Name="BtnHwFolder" Content="{DynamicResource L_HwFolder}" Style="{StaticResource BtnLink}" VerticalAlignment="Center"/>
          </WrapPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel x:Name="HwResultPanel"/>
              <TextBlock Text="{DynamicResource L_HwList}" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
              <StackPanel x:Name="HwHistoryPanel"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ===== Vue : sites ===== -->
        <Grid x:Name="ViewSites" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button x:Name="BtnEditLinks" DockPanel.Dock="Right" Content="{DynamicResource L_EditLinks}" Style="{StaticResource BtnSmall}"/>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Text="{DynamicResource L_SitesHelp}"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SitesPanel"/>
          </ScrollViewer>
        </Grid>

        <!-- ===== Vue : liens (modifiables) ===== -->
        <Grid x:Name="ViewLinks" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnLinksReset" Content="{DynamicResource L_LinksReset}" Style="{StaticResource BtnLink}" Margin="0,0,8,0"/>
              <Button x:Name="BtnLinkAdd" Content="{DynamicResource L_LinkAdd}" Style="{StaticResource BtnSmall}" Margin="0,0,8,0"/>
              <Button x:Name="BtnLinksSave" Content="{DynamicResource L_Save}" Style="{StaticResource BtnPrimary}" Padding="14,6"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Text="{DynamicResource L_LinksHelp}"/>
          </DockPanel>
          <Grid Grid.Row="1" Margin="17,0,14,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource L_ColCategory}" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource L_ColName}" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource L_ColAddress}" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LinksPanel"/>
          </ScrollViewer>
        </Grid>

        <!-- ===== Vue : paramètres ===== -->
        <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,6,0">

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_SetCheckTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{DynamicResource L_SetCheckHelp}" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                <WrapPanel>
                  <RadioButton x:Name="RbFreqStartup" GroupName="Freq" Style="{StaticResource Segment}" Content="{DynamicResource L_FreqStartup}"/>
                  <RadioButton x:Name="RbFreqDaily" GroupName="Freq" Style="{StaticResource Segment}" Content="{DynamicResource L_FreqDaily}"/>
                  <RadioButton x:Name="RbFreqWeekly" GroupName="Freq" Style="{StaticResource Segment}" Content="{DynamicResource L_FreqWeekly}"/>
                  <RadioButton x:Name="RbFreqNever" GroupName="Freq" Style="{StaticResource Segment}" Content="{DynamicResource L_FreqNever}"/>
                </WrapPanel>
                <CheckBox x:Name="ChkNotify" Style="{StaticResource Toggle}" Margin="0,14,0,0"
                          Content="{DynamicResource L_SetNotify}"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_SetNvidiaTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{DynamicResource L_SetNvidiaHelp}" Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                <WrapPanel>
                  <RadioButton x:Name="RbGameReady" GroupName="Nvidia" Style="{StaticResource Segment}" Content="{DynamicResource L_GameReady}"/>
                  <RadioButton x:Name="RbStudio" GroupName="Nvidia" Style="{StaticResource Segment}" Content="{DynamicResource L_Studio}"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_SetTheme}" Style="{StaticResource SectionTitle}"/>
                <WrapPanel Margin="0,10,0,0">
                  <RadioButton x:Name="RbLight" GroupName="Theme" Style="{StaticResource Segment}" Content="{DynamicResource L_ThemeLight}"/>
                  <RadioButton x:Name="RbDark" GroupName="Theme" Style="{StaticResource Segment}" Content="{DynamicResource L_ThemeDark}"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_SetBackupTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap"
                           Text="{DynamicResource L_SetBackupHelp}"/>
                <WrapPanel>
                  <RadioButton x:Name="RbKeep1" GroupName="Keep" Style="{StaticResource Segment}" Content="{DynamicResource L_Keep1}"/>
                  <RadioButton x:Name="RbKeep2" GroupName="Keep" Style="{StaticResource Segment}" Content="{DynamicResource L_Keep2}"/>
                  <RadioButton x:Name="RbKeep3" GroupName="Keep" Style="{StaticResource Segment}" Content="{DynamicResource L_Keep3}"/>
                  <RadioButton x:Name="RbKeep5" GroupName="Keep" Style="{StaticResource Segment}" Content="{DynamicResource L_Keep5}"/>
                </WrapPanel>
                <TextBlock x:Name="BackupSizeText" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_SetIgnoredTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{DynamicResource L_SetIgnoredHelp}" Style="{StaticResource Muted}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                <StackPanel x:Name="IgnoredPanel"/>
                <TextBlock x:Name="IgnoredEmpty" Text="{DynamicResource L_NoIgnored}" Style="{StaticResource Muted}" FontStyle="Italic"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_SetLangTitle}" Style="{StaticResource SectionTitle}"/>
                <WrapPanel Margin="0,10,0,0">
                  <RadioButton x:Name="RbLangFr" GroupName="Lang" Style="{StaticResource Segment}" Content="Français"/>
                  <RadioButton x:Name="RbLangEn" GroupName="Lang" Style="{StaticResource Segment}" Content="English"/>
                </WrapPanel>
                <TextBlock Text="{DynamicResource L_SetZoomTitle}" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
                <WrapPanel Margin="0,10,0,0">
                  <RadioButton x:Name="RbZoom100" GroupName="Zoom" Style="{StaticResource Segment}" Content="100 %"/>
                  <RadioButton x:Name="RbZoom115" GroupName="Zoom" Style="{StaticResource Segment}" Content="115 %"/>
                  <RadioButton x:Name="RbZoom130" GroupName="Zoom" Style="{StaticResource Segment}" Content="130 %"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_SetProvidersTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{DynamicResource L_SetProvidersHelp}" Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                <CheckBox x:Name="ChkProvNvidia" Style="{StaticResource Toggle}" Content="{DynamicResource L_ProvNvidia}"/>
                <CheckBox x:Name="ChkProvWu" Style="{StaticResource Toggle}" Content="{DynamicResource L_ProvWu}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{DynamicResource L_SetTransferTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{DynamicResource L_SetTransferHelp}" Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button x:Name="BtnExport" Content="{DynamicResource L_Export}" Style="{StaticResource BtnSmall}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnImport" Content="{DynamicResource L_Import}" Style="{StaticResource BtnSmall}"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Driver" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="AppVersionText" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                <CheckBox x:Name="ChkAutoUpdate" Style="{StaticResource Toggle}" Content="{DynamicResource L_SetAutoUpdate}"/>
                <Button x:Name="BtnCheckAppUpdate" Content="{DynamicResource L_CheckNow}" Style="{StaticResource BtnSmall}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                <TextBlock Text="{DynamicResource L_SetRepoTitle}" FontWeight="SemiBold" Margin="0,16,0,2"/>
                <TextBlock Text="{DynamicResource L_SetRepoHelp}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <DockPanel>
                  <Button x:Name="BtnRepoReset" DockPanel.Dock="Right" Content="{DynamicResource L_Default}" Style="{StaticResource BtnLink}" Margin="6,0,0,0"/>
                  <Button x:Name="BtnRepoSave" DockPanel.Dock="Right" Content="{DynamicResource L_Save}" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"/>
                  <TextBox x:Name="TxtRepo" MaxWidth="420" HorizontalAlignment="Left" MinWidth="300"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
