<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver" Width="1180" Height="780" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#17202A"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>

    <!-- ===== Cartes ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E3E8ED"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style x:Key="CardWarn" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="BorderBrush" Value="#F59E0B"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5D6B78"/>
    </Style>

    <!-- ===== Boutons ===== -->
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#17202A"/>
      <Setter Property="BorderBrush" Value="#D3DAE1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="#0F766E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F766E"/>
    </Style>

    <!-- ===== Menu de gauche ===== -->
    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#B8C7D6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1A3249"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Interrupteur (point de restauration) ===== -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#17202A"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="#CBD5E1">
                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#0F766E"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Case à cocher des lignes ===== -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="box" Width="20" Height="20" CornerRadius="5" BorderBrush="#9FB3C5" BorderThickness="1.5" Background="White">
              <Path x:Name="mark" Data="M4,10 L8,14 L16,6" Stroke="White" StrokeThickness="2.2" Visibility="Collapsed"
                    Stretch="None" Margin="-1.5,-1.5,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#0F766E"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#0F766E"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Tableau "Tous les pilotes" ===== -->
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="Margin" Value="14,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="#5D6B78"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="BorderBrush" Value="#E3E8ED"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#17202A"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E6F4F1"/>
          <Setter Property="Foreground" Value="#17202A"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Menu de gauche ================= -->
    <Border Background="#12263A">
      <DockPanel Margin="14,20,14,16" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
          <Border Width="30" Height="30" CornerRadius="8" Background="#2DD4BF">
            <Path Data="M8,15 L13,20 L22,10" Stroke="#0B1F33" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"/>
          </Border>
          <TextBlock Text="Driver" Foreground="White" FontSize="20" FontWeight="Bold" Margin="11,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="NavDashboard" DockPanel.Dock="Top" Style="{StaticResource Nav}">
          <TextBlock Text="Tableau de bord"/>
        </Button>
        <Button x:Name="NavUpdates" DockPanel.Dock="Top" Style="{StaticResource Nav}">
          <Grid>
            <TextBlock Text="Mises à jour"/>
            <Border x:Name="UpdatesBadge" HorizontalAlignment="Right" Background="#2DD4BF" CornerRadius="9" Padding="7,0" Visibility="Collapsed">
              <TextBlock x:Name="UpdatesBadgeText" Text="0" Foreground="#0B1F33" FontWeight="SemiBold" FontSize="11.5"/>
            </Border>
          </Grid>
        </Button>
        <Button x:Name="NavAll" DockPanel.Dock="Top" Style="{StaticResource Nav}">
          <TextBlock Text="Tous les pilotes"/>
        </Button>
        <Border DockPanel.Dock="Top" Height="1" Background="#21405C" Margin="10,10,10,14"/>
        <Button x:Name="NavPackage" DockPanel.Dock="Top" Style="{StaticResource Nav}">
          <TextBlock Text="Installer un paquet"/>
        </Button>
        <Button x:Name="NavBoard" DockPanel.Dock="Top" Style="{StaticResource Nav}">
          <TextBlock Text="Site de la carte mère"/>
        </Button>
        <Button x:Name="NavLogs" DockPanel.Dock="Top" Style="{StaticResource Nav}">
          <TextBlock Text="Journaux"/>
        </Button>

        <Border DockPanel.Dock="Bottom" Background="#1A3249" CornerRadius="10" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="PcName" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock x:Name="PcInfo" Foreground="#B8C7D6" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ================= Contenu ================= -->
    <Grid Grid.Column="1" Margin="28,22,28,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- En-tête -->
      <Grid>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Tableau de bord" FontSize="24" FontWeight="Bold"/>
          <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,3,0,0" Text="Prêt"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnSearch" Content="Analyser" Style="{StaticResource BtnBase}" Margin="0,0,8,0"/>
          <Button x:Name="BtnInstall" Content="Installer" Style="{StaticResource BtnPrimary}" IsEnabled="False"/>
        </StackPanel>
      </Grid>

      <ProgressBar x:Name="Busy" Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                   Margin="0,12,0,0" Foreground="#0F766E" Background="#DCE7EA" BorderThickness="0"/>

      <Grid Grid.Row="2" Margin="0,16,0,0">

        <!-- ===== Vue : tableau de bord ===== -->
        <Grid x:Name="ViewDashboard">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <UniformGrid Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Périphériques analysés" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="KpiDevices" Text="-" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Mises à jour disponibles" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="KpiUpdates" Text="-" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Point de restauration" Style="{StaticResource Muted}"/>
                <CheckBox x:Name="ChkRestore" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,11,0,0"
                          Content="Avant chaque installation"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="CardsPanel" Columns="3" VerticalAlignment="Top" Margin="0,0,-12,0"/>
          </ScrollViewer>

          <Grid Grid.Row="2" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.4*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DropZone" Cursor="Hand" Background="Transparent">
              <Rectangle RadiusX="12" RadiusY="12" Stroke="#9FB3C5" StrokeThickness="2" StrokeDashArray="4 3" Fill="White"/>
              <StackPanel Orientation="Horizontal" Margin="20,16" VerticalAlignment="Center">
                <Path Data="M15,4 L15,19 M8.5,12.5 L15,19 L21.5,12.5 M5,25 L25,25" Stroke="#0F766E" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="None" VerticalAlignment="Center"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Installer un pilote téléchargé" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Text="Glisse le ZIP dans la fenêtre, ou clique ici pour le choisir" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
              <StackPanel>
                <TextBlock Text="Activité récente" FontWeight="SemiBold"/>
                <TextBlock x:Name="ActivityText" Style="{StaticResource Muted}" FontSize="12" LineHeight="20"
                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Text="Aucune activité aujourd'hui."/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ===== Vue : mises à jour ===== -->
        <Grid x:Name="ViewUpdates" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="UpdatesPanel"/>
          </ScrollViewer>
          <TextBlock x:Name="UpdatesEmpty" Text="Aucune mise à jour disponible : tout est à jour." Style="{StaticResource Muted}"
                     FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- ===== Vue : tous les pilotes ===== -->
        <Border x:Name="ViewAll" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0">
          <DataGrid x:Name="AllGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F4" BorderThickness="0"
                    Background="Transparent" RowBackground="White" AlternatingRowBackground="#FAFBFC"
                    CanUserAddRows="False" SelectionMode="Single" RowHeight="36" Margin="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Périphérique" Binding="{Binding Name}" Width="2.2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Fabricant" Binding="{Binding Manufacturer}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Version installée" Binding="{Binding DriverVersion}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="1.4*" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
